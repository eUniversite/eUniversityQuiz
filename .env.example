# Base PostgreSQL (docker compose up -d db)
DATABASE_URL=postgresql://euniv:euniv@localhost:5442/euniv_live
PORT=3100
# Secret de signature des jetons professeur : générez-en un long et aléatoire (openssl rand -hex 32)
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
# URL publique vue par les téléphones (utilisée dans le QR code). Ex: http://192.168.1.20:3100
PUBLIC_URL=http://localhost:5173
# Compte professeur créé par `npm run db:seed`
TEACHER_EMAIL=prof@euniversite.local
TEACHER_PASSWORD=ChangeMoi!2024
TEACHER_NAME=Professeur Démo
# Origines autorisées (CORS / Socket.IO), séparées par des virgules. Vide = même origine uniquement.
CORS_ORIGINS=http://localhost:5173
# 1 si le serveur est derrière un proxy inverse (IP client lue via X-Forwarded-For)
TRUST_PROXY=0

# --- Envoi d'e-mails (vérification d'adresse, réinitialisation de mot de passe) ---
# Si SMTP_HOST est vide : aucun e-mail n'est envoyé, les routes de renvoi renvoient
# une erreur explicite et la vérification d'e-mail n'est PAS exigée à la création de session.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=eUniversité Quiz <no-reply@euniversite.ci>
# 0 pour désactiver l'exigence de vérification d'e-mail avant l'ouverture d'une session (défaut : 1)
REQUIRE_VERIFIED_EMAIL=1

# --- Study : création de parcours par LLM (Gemini pour les essais) ---
# Clé API Gemini (https://aistudio.google.com/apikey). Sans clé, l'import de cours répond « non activé ».
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Modèles de secours (séparés par des virgules), essayés si le principal est surchargé ou retiré
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# Nombre de questions visé par parcours et taille maximale d'un import
STUDY_QUESTIONS=8
STUDY_MAX_UPLOAD_MB=10

# --- Abonnement Study : paiement GeniusPay (https://geniuspay.ci/dashboard → clés API) ---
# Sandbox : pk_sandbox_… / sk_sandbox_… ; production : pk_live_… / sk_live_…
# Sans clés (hors production) le paiement est simulé et ouvre l'accès tout de suite.
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
# Secret whsec_… du webhook créé dans GeniusPay avec l'URL : <adresse publique>/api/billing/webhook/geniuspay
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_BASE_URL=https://geniuspay.ci/api/v1/merchant
# Polling de secours : secondes laissées au webhook après le retour de l'étudiant, puis s'il ne revient jamais
BILLING_WEBHOOK_GRACE=30
BILLING_UNRETURNED_AFTER=600

# Plan Découverte (compte sans abonnement)
FREE_UPLOAD_MB=2
FREE_COURSES=1
FREE_MISSIONS=3

# Connexion Google : identifiant client OAuth « Application Web » (console Google Cloud ; origines JS autorisées = URL du site)
GOOGLE_CLIENT_ID=

# SSO interne (OpenID Connect) : applications autorisées et clé de signature RSA (PEM, sauts de ligne écrits \n)
# SSO_CLIENTS=[{"id":"activate","name":"eUniversité Activate","secret":"change-me","redirectUris":["https://activate.exemple.ci/sso/callback"]}]
# SSO_PRIVATE_KEY=

# Backoffice (/admin) : e-mails des enseignants autorisés (adresse vérifiée obligatoire), séparés par des virgules
ADMIN_EMAILS=
